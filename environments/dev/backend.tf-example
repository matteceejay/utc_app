terraform {
  backend "s3" {
    bucket       = "<TFSTATE_BUCKET_NAME>"       # e.g. utc-app-tfstate-<account-id>
    key          = "dev/terraform.tfstate"
    region       = "<AWS_REGION>"                # e.g. us-east-1
    encrypt      = true
    use_lockfile = true                          # native S3 locking, Terraform >= 1.10
  }
}